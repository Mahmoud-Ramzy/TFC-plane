# ========================================================================== #
# TFC-Plane production environment
# Copy to `.env` in the repo root and edit the values below.
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d
# ========================================================================== #

# Which GHCR image prefix + release tag to pull.
# Set TFC_IMAGE_PREFIX to your GitHub username (the workflow publishes under
# ghcr.io/<github-owner>/tfc-plane-<service>). APP_RELEASE can be `latest` or a
# specific commit SHA.
TFC_IMAGE_PREFIX=ghcr.io/mahmoud-ramzy
APP_RELEASE=latest

# --- Proxy / domain (HTTP only for the first deployment) ---
APP_DOMAIN=localhost
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=80
# Optional: leave empty for HTTP-only. Set to "acme_dns <provider> <key>" later for AutoTLS.
CERT_ACME_DNS=
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0

# --- PostgreSQL ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=plane

# --- Valkey / Redis ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# --- RabbitMQ ---
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me-strong-password
RABBITMQ_VHOST=plane

# --- MinIO / S3 object storage ---
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key-very-long
AWS_REGION=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

# --- File uploads ---
FILE_SIZE_LIMIT=5242880

# --- Application (API / worker / beat) ---
WEB_URL=http://localhost
DEBUG=0
GUNICORN_WORKERS=2
CORS_ALLOWED_ORIGINS=http://localhost
DATABASE_URL=postgresql://plane:change-me-strong-password@plane-db:5432/plane
SECRET_KEY=change-me-to-a-long-random-string
AMQP_URL=amqp://plane:change-me-strong-password@plane-mq:5672/plane
API_KEY_RATE_LIMIT=60/minute
# --- Live app ---
API_BASE_URL=http://api:8000
LIVE_SERVER_SECRET_KEY=change-me-live-secret
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=